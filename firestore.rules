rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True only for accounts explicitly listed in the admins collection —
    // not just anyone with a Firebase Auth login. This matters because
    // Firebase Auth sign-up is open by default; without this check, anyone
    // who created their own account (even outside this site) would count
    // as an admin.
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The admin list itself. Only existing admins can read it or add/remove
    // someone from it. The very first admin has to be added by hand in the
    // Firebase Console (see README) — after that, admins can add more
    // through the dashboard.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Members are keyed by roll number. Public info only (name, roll number)
    // — no secrets live here. Anyone can read (needed for check-in to
    // verify a roll number, and for the public homepage). Only an admin
    // can add, edit, or delete.
    match /members/{rollNumber} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Attendance is public to insert (that's what makes QR check-in work
    // without a login) and public to read (so the homepage can show stats).
    // Only an admin can edit/delete a log entry.
    match /attendance/{entryId} {
      allow read: if true;
      allow create: if exists(/databases/$(database)/documents/members/$(request.resource.data.member_id));
      allow update, delete: if isAdmin();
    }
  }
}
